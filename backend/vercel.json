{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/create",
            "dest": "server.js"
        },
        {
            "src": "/note",
            "dest": "server.js"
        },
        {
            "src": "/notes",
            "dest": "server.js"
        },
        {
            "src": "/quizzes",
            "dest": "server.js"
        },
        {
            "src": "/",
            "dest": "server.js"
        }
    ]
}